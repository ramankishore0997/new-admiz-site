# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Auth
JWT_SECRET=your-jwt-secret-here

# Telegram Admin Bot (server-side only — NEVER commit the real token)
# 1. Create a bot with @BotFather and paste the token here / in the platform env.
# 2. Send any message to the bot, then get your numeric chat ID
#    (e.g. via @userinfobot or the Bot API getUpdates method).
# 3. Only this numeric chat ID can administer the site through the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Epusdt Payment Gateway
EPUSDT_API_URL=https://pay.yourdomain.com
EPUSDT_API_TOKEN=your-epusdt-api-auth-token
EPUSDT_WEBHOOK_BASE_URL=https://yourdomain.com
